# Copy to `.env.local` (development) or pass these as container environment variables.
# Every value below is optional; the defaults suit a laptop.

# ---------------------------------------------------------------------------
# Screenshot capture
# ---------------------------------------------------------------------------
# false = plain bookmark manager. Cards show a domain tile, nothing is queued, and the retry
# affordance is hidden.
CAPTURE_ENABLED=true

# Renderers to try, in order. Comma-separated, first success wins:
#   local   Chromium on this machine (~280MB disk, 150-250MB RAM per page, no key)
#   thum    slot 1 API — keyless by default (thum.io)
#   sb      slot 2 API — keyed by default (screenshotbase, free 300/month)
#   none    capture off
#
#   local           render here only
#   local,thum,sb   local first, then the keyless API, then the keyed one   <- recommended
#   thum,sb         no local browser at all (lowest RAM; needs network)
#   sb              the keyed service only
CAPTURE_PROVIDER=local

# How many captures may run at once. A chain containing `local` is capped at 2 regardless of
# this value; a chain of API slots only honours it up to 8.
CAPTURE_CONCURRENCY=2

# Per-capture navigation budget, in milliseconds.
CAPTURE_TIMEOUT_MS=30000

# How long a Chromium launch may take before it counts as a failure. A hung launch otherwise
# holds a queue slot forever, which shows up as a card stuck on "Capturing preview...".
CAPTURE_LAUNCH_TIMEOUT_MS=30000

# Keep Chromium warm between captures. Saves ~1s per capture, costs 100-150MB while idle.
# Set false on a memory-tight machine: the process is closed after every capture.
CAPTURE_KEEP_BROWSER_ALIVE=true

# Screenshot viewport. The card crops to 16:10 anyway.
CAPTURE_VIEWPORT_WIDTH=1280
CAPTURE_VIEWPORT_HEIGHT=800

# ---------------------------------------------------------------------------
# API slot 1 — `thum`
# ---------------------------------------------------------------------------
# Placeholders: {url} (URL-encoded), {width}, {height}, {key}.
# thum.io needs no key. Verified working: PNG, ~1-2s per page, rate-limited but free.
CAPTURE_THUM_URL=https://image.thum.io/get/width/{width}/crop/{height}/{url}
CAPTURE_THUM_KEY=

# ---------------------------------------------------------------------------
# API slot 2 — `sb`
# ---------------------------------------------------------------------------
# When the URL has no {key}, the key is sent as an `apikey` header (screenshotbase's scheme).
# screenshotbase free tier: 300 captures/month — https://app.screenshotbase.com/register
# site-shot is paid-only and returns 403 "No active subscription found" without a plan.
CAPTURE_SB_URL=https://api.screenshotbase.com/v1/take?url={url}&format=webp&viewport_width={width}&viewport_height={height}
CAPTURE_SB_KEY=

# Hard ceiling on one API capture, in milliseconds.
CAPTURE_API_TIMEOUT_MS=60000

# Read title/description from the page's own HTML when a capture returns only an image.
# Costs no API quota. Set false to keep the title the bookmark was saved with.
CAPTURE_API_METADATA=true
